  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <!--
    The tests host the web app, so they run on the ASP.NET Core shared framework
    anyway. Saying so lets restore prune the packages that framework already ships
    (DataProtection, System.Security.Cryptography.Xml/Pkcs, pulled in by OpenIddict)
    instead of pinning their 10.0.11 copies, which fail the NuGet audit.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Umbral/Umbral.fsproj" />
  </ItemGroup>

</Project>
