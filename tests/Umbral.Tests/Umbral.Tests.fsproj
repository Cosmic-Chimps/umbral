    <Compile Include="Infrastructure/PngBuilder.fs" />
    <Compile Include="IdsTests.fs" />
    <Compile Include="OidcDomainTests.fs" />
    <Compile Include="OidcDiscoveryTests.fs" />
    <Compile Include="OidcAdapterTests.fs" />
    <Compile Include="StubOidcProviderTests.fs" />
    <Compile Include="OidcConnectorStoreTests.fs" />
    <Compile Include="StartResolveTests.fs" />
    <Compile Include="LinkingRuleTests.fs" />
    <Compile Include="RedirectUriTests.fs" />
    <Compile Include="ProviderAdapterTests.fs" />
    <Compile Include="AdminAuthTests.fs" />
    <Compile Include="UserStoreTests.fs" />
    <Compile Include="PublicOriginTests.fs" />
    <Compile Include="KeyPersistenceTests.fs" />
    <Compile Include="SecretsTests.fs" />
    <Compile Include="DatabaseTests.fs" />
    <Compile Include="SecurityEventsTests.fs" />
    <Compile Include="BootstrapTests.fs" />
    <Compile Include="SignInFlowTests.fs" />
    <Compile Include="AdminScreenTests.fs" />
    <Compile Include="FakeConnectorGuardTests.fs" />
    <Compile Include="FirstLoginTests.fs" />
    <Compile Include="CredentialTests.fs" />
    <Compile Include="ConnectorRuntimeTests.fs" />
    <Compile Include="ConnectorDeleteTests.fs" />
    <Compile Include="SecurityEventCoverageTests.fs" />
    <Compile Include="OidcProtocolTests.fs" />
    <Compile Include="OAuthRoundTripTests.fs" />
    <Compile Include="RateLimitTests.fs" />
    <Compile Include="TrustedProxiesTests.fs" />
    <Compile Include="AdminLandingTests.fs" />
    <Compile Include="HomeTests.fs" />
    <Compile Include="MessagePageTests.fs" />
    <Compile Include="SubcommandTests.fs" />
    <Compile Include="LoggingDefaultsTests.fs" />
    <Compile Include="PageAssetsTests.fs" />
    <Compile Include="MetaTests.fs" />
    <Compile Include="LogRedactionTests.fs" />
    <Compile Include="OidcConnectorTests.fs" />
    <Compile Include="CsrfTests.fs" />
    <Compile Include="RestartTests.fs" />
    <Compile Include="IdleMemoryTests.fs" />
