    <Compile Include="AppConnectorChoiceTests.fs" />
    <Compile Include="MultipleConnectorsTests.fs" />
    <Compile Include="NoConfigFileTests.fs" />
    <Compile Include="SecretStoreSettingsTests.fs" />
    <Compile Include="SecretStoreWiringTests.fs" />
    <Compile Include="AwsSecretStoreTests.fs" />
    <Compile Include="GcpSecretStoreTests.fs" />
    <Compile Include="AzureSecretStoreTests.fs" />
    <Compile Include="BellaBaxterSecretStoreTests.fs" />
    <Compile Include="SecretCacheTests.fs" />
    <Compile Include="ExternalSecretConnectorTests.fs" />
    <Compile Include="SecretMoveTests.fs" />
    <Compile Include="AccentTests.fs" />
    <Compile Include="PngLogoTests.fs" />
    <Compile Include="BrandingStoreTests.fs" />
    <Compile Include="BrandingEndpointTests.fs" />
    <Compile Include="SignInBrandingTests.fs" />
    <Compile Include="AppBrandingAdminTests.fs" />
