<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Microsoft.Testing.Platform tests are executables, not libraries. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Same compile-order constraint as the web project: helpers before the tests that use them. -->
  <ItemGroup>
    <Compile Include="SmokeTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Umbral/Umbral.fsproj" />
  </ItemGroup>

</Project>
