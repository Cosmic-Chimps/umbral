<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Microsoft.Testing.Platform tests are executables, not libraries. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Same compile-order constraint as the web project: helpers before the tests that use them. -->
  <ItemGroup>
    <Compile Include="Infrastructure/Fixtures.fs" />
    <Compile Include="IdsTests.fs" />
    <Compile Include="LinkingRuleTests.fs" />
    <Compile Include="ProviderAdapterTests.fs" />
    <Compile Include="AdminAuthTests.fs" />
    <Compile Include="UserStoreTests.fs" />
    <Compile Include="PublicOriginTests.fs" />
    <Compile Include="KeyPersistenceTests.fs" />
    <Compile Include="SecretsTests.fs" />
    <Compile Include="DatabaseTests.fs" />
    <Compile Include="SecurityEventsTests.fs" />
    <Compile Include="BootstrapTests.fs" />
    <Compile Include="SignInFlowTests.fs" />
    <Compile Include="AdminScreenTests.fs" />
    <Compile Include="FakeConnectorGuardTests.fs" />
    <Compile Include="FirstLoginTests.fs" />
    <Compile Include="ConfigFileTests.fs" />
    <Compile Include="ConnectorRuntimeTests.fs" />
    <Compile Include="OidcProtocolTests.fs" />
    <Compile Include="OAuthRoundTripTests.fs" />
    <Compile Include="SmokeTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Umbral/Umbral.fsproj" />
  </ItemGroup>

</Project>
