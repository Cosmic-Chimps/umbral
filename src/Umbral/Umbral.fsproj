<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Umbral</AssemblyName>
    <RootNamespace>Umbral</RootNamespace>
    <!--
      Development only. ASP.NET Core adds user secrets to IConfiguration in the
      Development environment and nowhere else, which is exactly the boundary we
      want: a developer keeps upstream connector credentials out of the repo
      without inventing a mechanism, and nothing changes for a deployment, where
      the same values arrive as environment variables.

      User secrets are PLAINTEXT in ~/.microsoft/usersecrets. That is fine for a
      developer's own machine and never acceptable for an instance serving real
      logins — the secret an operator saves goes through ISecretStore (Secrets.fs).
    -->
    <UserSecretsId>umbral-dev-0ddb1e71</UserSecretsId>
    <!-- SC-007 puts a 150 MB ceiling on idle residency; workstation GC is how we get there. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    F# compiles in this order and a file sees only what comes before it, so this
    list IS the dependency graph. Keep it: Domains -> Infrastructure -> Views
    (Texts -> Theme -> Components -> Layout) -> Handlers -> Program.fs last.

    Adding an endpoint is three steps and missing the third is silent:
      1. the file under Handlers/
      2. a <Compile Include> here, before Program.fs
      3. its `endpoint` added to Program.endpoints
    T102's meta-test turns a missed step 3 into a build failure. Until then, check by hand.
  -->
  <ItemGroup>
    <Compile Include="Domains/Ids.fs" />
    <Compile Include="Infrastructure/PublicOrigin.fs" />
    <Compile Include="Infrastructure/DataDirectory.fs" />
    <Compile Include="Infrastructure/Keys.fs" />
    <Compile Include="Infrastructure/Secrets.fs" />
    <Compile Include="Infrastructure/Database.fs" />
    <Compile Include="Infrastructure/SecurityEvents.fs" />
    <Compile Include="Views/Texts.fs" />
    <Compile Include="Views/Theme.fs" />
    <Compile Include="Views/Components.fs" />
    <Compile Include="Views/Layout.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      For the DbContext and its migrations, which MigrateAsync needs at RUNTIME
      and not only at design time. One-way: nothing in Umbral.Migrations refers
      back here.
    -->
    <ProjectReference Include="../Umbral.Migrations/Umbral.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oxpecker" Version="2.1.1" />
    <PackageReference Include="Oxpecker.ViewEngine" Version="2.1.*" />
    <PackageReference Include="Oxpecker.Htmx" Version="4.0.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.Quartz" Version="7.7.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

</Project>
