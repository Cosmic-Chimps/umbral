<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Umbral</AssemblyName>
    <RootNamespace>Umbral</RootNamespace>
    <!--
      Development only. ASP.NET Core adds user secrets to IConfiguration in the
      Development environment and nowhere else, which is exactly the boundary we
      want: a developer keeps upstream connector credentials out of the repo
      without inventing a mechanism, and nothing changes for a deployment, where
      the same values arrive as environment variables.

      User secrets are PLAINTEXT in ~/.microsoft/usersecrets. That is fine for a
      developer's own machine and never acceptable for an instance serving real
      logins — the secret an operator saves goes through ISecretStore (Secrets.fs).
    -->
    <UserSecretsId>umbral-dev-0ddb1e71</UserSecretsId>
    <!-- SC-007 puts a 150 MB ceiling on idle residency; workstation GC is how we get there. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    F# compiles in this order and a file sees only what comes before it, so this
    list IS the dependency graph. Keep it: Domains -> Infrastructure -> Views
    (Texts -> Theme -> Components -> Layout) -> Handlers -> Program.fs last.

    Adding an endpoint is three steps and missing the third is silent:
      1. the file under Handlers/
      2. a <Compile Include> here, before Program.fs
      3. its `endpoint` added to Program.endpoints
    MetaTests.fs ("every handler module's endpoint is in Program.endpoints") turns a
    missed step 3 into a failing test that names the module. It is a test, not a
    build error: `dotnet build` alone will not tell you, `dotnet test` will.
  -->
  <ItemGroup>
    <Compile Include="Domains/Ids.fs" />
    <Compile Include="Domains/Connectors.fs" />
    <Compile Include="Domains/Linking.fs" />
    <Compile Include="Domains/ConfigDocument.fs" />
    <Compile Include="Infrastructure/PublicOrigin.fs" />
    <Compile Include="Infrastructure/DataDirectory.fs" />
    <Compile Include="Infrastructure/Keys.fs" />
    <Compile Include="Infrastructure/Secrets.fs" />
    <Compile Include="Infrastructure/Database.fs" />
    <Compile Include="Infrastructure/SecurityEvents.fs" />
    <Compile Include="Infrastructure/LogRedaction.fs" />
    <Compile Include="Infrastructure/OAuthRoundTrip.fs" />
    <Compile Include="Infrastructure/ProviderAdapters.fs" />
    <Compile Include="Infrastructure/OidcDiscovery.fs" />
    <Compile Include="Infrastructure/Providers/Fake.fs" />
    <Compile Include="Infrastructure/Providers/Discord.fs" />
    <Compile Include="Infrastructure/Providers/GitHub.fs" />
    <Compile Include="Infrastructure/Providers/Google.fs" />
    <Compile Include="Infrastructure/Providers/Oidc.fs" />
    <Compile Include="Infrastructure/Users.fs" />
    <Compile Include="Infrastructure/ConnectorStore.fs" />
    <Compile Include="Infrastructure/AppConnectors.fs" />
    <Compile Include="Infrastructure/UserStore.fs" />
    <Compile Include="Infrastructure/AdminAuth.fs" />
    <Compile Include="Infrastructure/AppClients.fs" />
    <Compile Include="Infrastructure/ConfigFile.fs" />
    <Compile Include="Infrastructure/WebForms.fs" />
    <Compile Include="Infrastructure/RateLimits.fs" />
    <Compile Include="Infrastructure/Sessions.fs" />
    <Compile Include="Infrastructure/OpenIddictSetup.fs" />
    <Compile Include="Views/Texts.fs" />
    <Compile Include="Views/Theme.fs" />
    <Compile Include="Views/Components.fs" />
    <Compile Include="Views/Layout.fs" />
    <Compile Include="Handlers/Health.fs" />
    <Compile Include="Handlers/Admin/Landing.fs" />
    <Compile Include="Handlers/Admin/Setup.fs" />
    <Compile Include="Handlers/Admin/SignIn.fs" />
    <Compile Include="Handlers/Admin/SignOut.fs" />
    <Compile Include="Handlers/Admin/Credential.fs" />
    <Compile Include="Handlers/Admin/Connectors.fs" />
    <Compile Include="Handlers/Admin/ConnectorToggle.fs" />
    <Compile Include="Handlers/Admin/ConnectorDelete.fs" />
    <Compile Include="Handlers/Admin/ConfigExport.fs" />
    <Compile Include="Handlers/Dev/FakeProvider.fs" />
    <Compile Include="Handlers/Admin/Apps.fs" />
    <Compile Include="Handlers/Admin/AppSecret.fs" />
    <Compile Include="Handlers/Admin/AppDelete.fs" />
    <Compile Include="Handlers/Admin/Users.fs" />
    <Compile Include="Handlers/Admin/UserToggle.fs" />
    <Compile Include="Handlers/Admin/UserDelete.fs" />
    <Compile Include="Handlers/Connect/Picker.fs" />
    <Compile Include="Handlers/Connect/Start.fs" />
    <Compile Include="Handlers/Connect/Callback.fs" />
    <Compile Include="Handlers/Connect/UserInfo.fs" />
    <Compile Include="Handlers/Connect/EndSession.fs" />
    <Compile Include="Handlers/Connect/Error.fs" />
    <Compile Include="Handlers/Connect/Authorize.fs" />
    <Compile Include="Handlers/Connect/Token.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      For the DbContext and its migrations, which MigrateAsync needs at RUNTIME
      and not only at design time. One-way: nothing in Umbral.Migrations refers
      back here.
    -->
    <ProjectReference Include="../Umbral.Migrations/Umbral.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oxpecker" Version="2.1.1" />
    <PackageReference Include="Oxpecker.ViewEngine" Version="2.1.*" />
    <PackageReference Include="Oxpecker.Htmx" Version="4.0.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.Quartz" Version="7.7.1" />
    <!-- 4.x, not 3.x: OpenIddict.Quartz 7.7.1 requires Quartz >= 4.0.0. -->
    <PackageReference Include="Quartz" Version="4.*" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The discovery and JWKS client for the `oidc` connector
      (specs/002-generic-oidc-connector/research.md R2): it fetches
      {issuer}/.well-known/openid-configuration and the signing keys, caches
      them and refreshes on its own schedule, so key rotation needs no operator
      action and Umbral writes none of that code. Pinned to the version of the
      Microsoft.IdentityModel.* assemblies OpenIddict already brings in, so the
      family stays one version (see `dotnet list package` with its transitive option).
    -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
  </ItemGroup>

</Project>
