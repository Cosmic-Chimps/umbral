  "intent": "Sign in to Umbral with a Mastodon-compatible fediverse account through a built-in Fediverse connector",
  "decisions": [
    {
      "decision": "Support = OAuth metadata with S256 and app_registration_endpoint, or NodeInfo software gotosocial",
      "why": "PKCE is required; GoToSocial enforces S256 without metadata",
      "rejected": "Send PKCE to every server (Akkoma/Pleroma ignore it silently)"
    },
    {
      "decision": "Fediverse beside the adapters, not an IProviderAdapter",
      "why": "per-server client chosen at run time",
      "rejected": "Extend AuthorizeRequest/ExchangeRequest for one kind"
    },
    {
      "decision": "Second HttpClient umbral-fediverse with connect-time public-address guard",
      "why": "only check DNS cannot dodge; keeps LAN OIDC providers working",
      "rejected": "Guard on the shared umbral-provider client"
    },
    {
      "decision": "Per-server secrets always in the local Data Protection key ring",
      "why": "created by Umbral, one per server",
      "rejected": "The configured external secret store"
    },
    {
      "decision": "Client-credentials check before redirect when not checked in 24h; re-register once on invalid_client",
      "why": "Mastodon shows its own error for an unknown client and never redirects back",
      "rejected": "Detect only at token exchange"
    },
    {
      "decision": "Allowlist checks typed domain before contact and the WebFinger-resolved server after",
      "why": "FR-009 no contact with unlisted servers",
      "rejected": "Match only the resolved server"
    }
  ],
  "step_summaries": {
