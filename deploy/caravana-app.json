{
  "source": { "kind": "image" },
  "services": [
    {
      "name": "umbral",
      "image": "__IMAGE__",
      "ports": [{ "name": "http", "containerPort": 8080 }],
      "health": { "path": "/healthz" },
      "domains": [{ "host": "__DOMAIN__", "port": "http" }],
      "volumes": [{ "name": "umbral-data", "path": "/data" }],
      "env": [
        { "name": "UMBRAL__PUBLIC_ORIGIN", "value": "https://__DOMAIN__" },
        { "name": "UMBRAL__TRUSTED_PROXIES", "value": "10.99.0.1" }
      ]
    }
  ]
}
