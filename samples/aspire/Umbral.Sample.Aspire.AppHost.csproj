<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The client ID and secret live in user secrets, never in the repository. -->
    <UserSecretsId>umbral-sample-aspire</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosting package (AddUmbral), from source: a library, not a resource to run.
         The ASP.NET Core sample is not referenced: AppHost.cs starts it with AddDotnetProject. -->
    <ProjectReference Include="../../src/CosmicChimps.Aspire.Hosting.Umbral/CosmicChimps.Aspire.Hosting.Umbral.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
