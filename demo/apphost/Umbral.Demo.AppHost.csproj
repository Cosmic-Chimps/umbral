<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- On a laptop, the demo app's client secret and the Caravana settings live in user
         secrets; from CI they come from Bella Baxter. Never in the repository. -->
    <UserSecretsId>umbral-demo-apphost</UserSecretsId>
    <!-- ASPIRECOMPUTE003: AddContainerRegistry (AppHost.cs), which `aspire deploy` pushes the
         sample's and the site's images to, is still marked evaluation-only in Aspire 17. -->
    <NoWarn>$(NoWarn);ASPIRECOMPUTE003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <!-- PublishToCaravana and the per-resource calls. It brings Aspire.Hosting.Docker, which this
         AppHost uses no API of. -->
    <PackageReference Include="CosmicChimps.Aspire.Hosting.Caravana" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddUmbral, from this repository's source: a library, not a resource to run. Its default
         image tag is the last release in CHANGELOG.md; demo.yml passes the release's version
         explicitly, through the MSBuild property Version. The ASP.NET Core sample is not
         referenced: AppHost.cs starts it with AddDotnetProject. -->
    <ProjectReference Include="../../src/CosmicChimps.Aspire.Hosting.Umbral/CosmicChimps.Aspire.Hosting.Umbral.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
