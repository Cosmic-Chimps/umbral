<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- On a laptop, the demo app's client secret and the Caravana settings live in user
         secrets; from CI they come from Bella Baxter. Never in the repository. -->
    <UserSecretsId>umbral-demo-apphost</UserSecretsId>
    <!-- ASPIRE010: the orchestrator and the dashboard are restored from NuGet, so the AppHost
         runs with the pinned Aspire CLI (dotnet tool restore) and with dotnet run. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010;ASPIRECOMPUTE003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ASP.NET Core sample, as it is in this repository: the demo runs no copy of it. -->
    <ProjectReference Include="../../samples/aspnetcore/Umbral.Sample.AspNetCore.csproj" />
    <!-- AddUmbral, from source: a library, not a resource to run. Its default image tag is the
         first "## X.Y.Z" of CHANGELOG.md, the last release, so the demo always runs a released
         image (never latest, never an unreleased build). demo.yml passes the release's version
         explicitly. -->
    <ProjectReference Include="../../src/CosmicChimps.Aspire.Hosting.Umbral/CosmicChimps.Aspire.Hosting.Umbral.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- PublishToCaravana and the per-resource calls. -->
    <PackageReference Include="CosmicChimps.Aspire.Hosting.Caravana" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.5" />
  </ItemGroup>

</Project>
