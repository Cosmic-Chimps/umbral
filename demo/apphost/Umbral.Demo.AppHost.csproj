<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- On a laptop, the demo app's client secret and the Caravana settings live in user
         secrets; from CI they come from Bella Baxter. Never in the repository. -->
    <UserSecretsId>umbral-demo-apphost</UserSecretsId>
    <!-- ASPIRE010: the orchestrator and the dashboard are restored from NuGet, so the AppHost
         runs with the pinned Aspire CLI (dotnet tool restore) and with dotnet run. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010;ASPIRECOMPUTE003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ASP.NET Core sample, as it is in this repository: the demo runs no copy of it. -->
    <ProjectReference Include="../../samples/aspnetcore/Umbral.Sample.AspNetCore.csproj" />
    <!-- AddUmbral, from NuGet for now. TEMPORARY: the hosting package source in this repository is
         on Aspire 17, and this demo is still on Aspire 13.6.5 (the Caravana package below has no
         Aspire 17 release yet), so a project reference would mix two Aspire versions. 0.13.0 is
         built on Aspire 13.6.5 and its API is the one the source still has. Until the demo moves
         to Aspire 17 (phase 2, after the Caravana package's 17 release), it runs the image
         ghcr.io/cosmic-chimps/umbral:0.13.0 whatever MSBuild Version demo.yml passes: the image
         tag is baked into the package, not into this build. -->
    <PackageReference Include="CosmicChimps.Aspire.Hosting.Umbral" Version="0.13.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PublishToCaravana and the per-resource calls. -->
    <PackageReference Include="CosmicChimps.Aspire.Hosting.Caravana" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.5" />
  </ItemGroup>

</Project>
