[Unit]
Description=Report a failed reset of the Umbral demo

[Service]
Type=oneshot
# Posts the reset's last journal lines to a ntfy topic when /etc/umbral-demo/notify.env names
# one (NTFY_URL, and NTFY_TOKEN when the topic needs it); otherwise it only logs. Runs as
# root: it reads the journal of another unit.
EnvironmentFile=-/etc/umbral-demo/notify.env
ExecStart=/usr/local/lib/umbral-demo/notify_failed.sh
