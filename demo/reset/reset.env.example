# /etc/umbral-demo/reset.env on the Caravana host, owned by umbral-demo-reset, mode 0400:
# install.sh creates it from this file and refuses to overwrite it. The token is not here: it
# is the file /etc/umbral-demo/caravana-token (root, 0400), which systemd hands to the service.
CARAVANA_URL=https://caravana.example.com
CARAVANA_APP=umbral-demo
UMBRAL_SERVICE=umbral
# The golden snapshot: its id from the Backups tab of the app (or GET /v1/apps/umbral-demo/backups).
GOLDEN_BACKUP_ID=umbral-0000000000
# Once this Caravana pins backups (0.21.0 or later): comment GOLDEN_BACKUP_ID out and name the label.
# GOLDEN_LABEL=golden
# The day of the weekly copy of the blank instance, taken right after that day's successful
# reset (mon..sun, or never).
BACKUP_WEEKDAY=sun
