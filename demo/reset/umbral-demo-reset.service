[Unit]
Description=Reset the Umbral demo by restoring its golden snapshot through Caravana
Documentation=https://github.com/Cosmic-Chimps/umbral/tree/main/demo
After=network-online.target
Wants=network-online.target
# A run that fails, including one that never reached Caravana, is reported by the notifier.
OnFailure=umbral-demo-reset-failed.service

[Service]
Type=oneshot
# A system user of its own. The token is not in its environment: systemd reads
# /etc/umbral-demo/caravana-token (root, 0400) and hands it to this process alone, as the file
# $CREDENTIALS_DIRECTORY/caravana-token.
User=umbral-demo-reset
Group=umbral-demo-reset
EnvironmentFile=/etc/umbral-demo/reset.env
LoadCredential=caravana-token:/etc/umbral-demo/caravana-token
ExecStart=/usr/bin/python3 /usr/local/lib/umbral-demo/umbral_demo_reset.py
# It needs the network and nothing of the host.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
